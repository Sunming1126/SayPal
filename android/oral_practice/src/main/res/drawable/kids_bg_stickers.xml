<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kids_background" />
        </shape>
    </item>

    <item
        android:gravity="top|start"
        android:left="-40dp"
        android:top="-30dp">
        <shape android:shape="oval">
            <size android:width="240dp" android:height="140dp" />
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>

    <item
        android:gravity="top|start"
        android:left="80dp"
        android:top="10dp">
        <shape android:shape="oval">
            <size android:width="200dp" android:height="120dp" />
            <solid android:color="#2AFFFFFF" />
        </shape>
    </item>

    <item
        android:gravity="top|end"
        android:right="-30dp"
        android:top="30dp">
        <shape android:shape="oval">
            <size android:width="180dp" android:height="110dp" />
            <solid android:color="#22FFFFFF" />
        </shape>
    </item>

    <item
        android:gravity="bottom|end"
        android:right="-40dp"
        android:bottom="-40dp">
        <shape android:shape="oval">
            <size android:width="220dp" android:height="220dp" />
            <solid android:color="#1A8BD3FF" />
        </shape>
    </item>

    <item
        android:gravity="bottom|start"
        android:left="20dp"
        android:bottom="60dp">
        <shape android:shape="oval">
            <size android:width="120dp" android:height="120dp" />
            <solid android:color="#1AFFF3B0" />
        </shape>
    </item>

    <item
        android:gravity="center"
        android:top="140dp">
        <shape android:shape="oval">
            <size android:width="140dp" android:height="140dp" />
            <solid android:color="#14FF9DB5" />
        </shape>
    </item>

</layer-list>
