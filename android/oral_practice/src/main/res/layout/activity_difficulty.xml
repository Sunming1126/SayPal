<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/kids_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/kids_toolbar_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_top_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="難易度"
            android:textColor="@color/kids_on_background"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/div_top"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/kids_divider"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/sv_body"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btn_row">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_diff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/iv_icon_diff"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:tint="@color/kids_on_background" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="フロー"
                            android:textStyle="bold"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/tg_difficulty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_diff_1"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="初級"
                            android:checkable="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_diff_2"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="中級"
                            android:checkable="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_diff_3"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="上級"
                            android:checkable="true" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_modules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/iv_icon_modules"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:tint="@color/kids_on_background" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="モジュール拼接"
                            android:textStyle="bold"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/rg_modules_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rb_modules_default"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="デフォルト" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rb_modules_custom"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="教学とテスト" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rb_modules_roleplay"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="原文ロールプレイ" />

                    </RadioGroup>

                    <LinearLayout
                        android:id="@+id/box_modules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="シャドウイング"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <RadioGroup
                            android:id="@+id/rg_repeat_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rb_repeat_none"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="不シャドウイング（关闭）" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rb_repeat_word"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="词语シャドウイング（逐个单词）" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rb_repeat_sentence"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="词句シャドウイング（逐句）" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rb_repeat_fast"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="快速シャドウイング（一次教多句）" />

                        </RadioGroup>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="会話モード"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />

                        <RadioGroup
                            android:id="@+id/rg_roleplay_script_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rb_roleplay_none"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="会話なし（オフ）" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rb_roleplay_script_guided"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="原文ロールプレイ（带教学提示下一句）" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rb_roleplay_script_strict"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="原文ロールプレイ（无教学提示）" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rb_roleplay_extend_guided"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="原文拡張（まず原文を復刻し、会話を拡張）" />

                        </RadioGroup>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="試験"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />

                        <RadioGroup
                            android:id="@+id/rg_exam_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rb_exam_none"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="不試験（关闭）" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rb_exam_word"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="词语試験（中译英）" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rb_exam_sentence"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="句子試験（中译英）" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rb_exam_mix"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="混合試験（随机抽查）" />

                        </RadioGroup>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_cn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/iv_icon_cn"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:tint="@color/kids_on_background" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="日本語含有量"
                            android:textStyle="bold"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/tg_cn_level"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_cn_high"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="多"
                            android:checkable="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_cn_mid"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="中"
                            android:checkable="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_cn_low"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="少"
                            android:checkable="true" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/btn_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存"
            android:textColor="@color/kids_on_background"
            app:strokeColor="@color/kids_secondary"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="戻る"
            android:textColor="@color/kids_on_background"
            app:strokeColor="@color/kids_secondary"
            app:strokeWidth="1dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
